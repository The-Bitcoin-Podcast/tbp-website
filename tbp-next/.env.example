# Copy to .env.local and fill in. Values starting with NEXT_PUBLIC_ are baked
# into the site at build time and are visible to visitors (that is expected:
# a signup form's POST URL is public by nature).

# Weekly newsletter signup. The form posts the visitor's email straight to your
# email service. Paste the form "action" URL from that service's embed code.
# Leave empty to show the form disabled with "Signups open soon."
NEXT_PUBLIC_NEWSLETTER_FORM_ACTION=

# The name of the email field your service expects.
# Buttondown and Kit use "email"; Mailchimp uses "EMAIL".
NEXT_PUBLIC_NEWSLETTER_EMAIL_FIELD=email
